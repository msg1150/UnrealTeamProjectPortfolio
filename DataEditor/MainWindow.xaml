<Window x:Class="JsonAssetDataEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JSON Asset Data Editor"
        Width="1280"
        Height="820"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="파일(_F)">
                <MenuItem Header="프로젝트 열기..." Click="OpenProject_Click" InputGestureText="Ctrl+O"/>
                <MenuItem Header="Manifest 새로고침" Click="ReloadManifest_Click" InputGestureText="F5"/>
                <Separator/>
                <MenuItem Header="저장" Click="Save_Click" InputGestureText="Ctrl+S"/>
                <Separator/>
                <MenuItem x:Name="ImportCsvMenu" Header="CSV 가져오기..." Click="ImportCsv_Click"/>
                <MenuItem x:Name="ExportCsvMenu" Header="CSV 내보내기..." Click="ExportCsv_Click"/>
                <Separator/>
                <MenuItem Header="종료" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="편집(_E)">
                <MenuItem Header="실행 취소" Click="Undo_Click" InputGestureText="Ctrl+Z"/>
                <MenuItem Header="다시 실행" Click="Redo_Click" InputGestureText="Ctrl+Y"/>
            </MenuItem>
            <MenuItem Header="보기(_V)">
                <MenuItem Header="모두 펼치기" Click="ExpandAll_Click"/>
                <MenuItem Header="모두 접기" Click="CollapseAll_Click"/>
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="프로젝트를 찾는 중..."/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="ProjectText"/>
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="#33000000" BorderThickness="0,0,1,0" Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="프로젝트 데이터"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="4,4,4,10"/>
                    <TreeView x:Name="AssetTree" SelectedItemChanged="AssetTree_SelectedItemChanged"/>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>

            <Grid Grid.Column="2">
                <TextBlock x:Name="EmptyText"
                           Text="왼쪽에서 DataTable, CurveTable 또는 DataAsset을 선택하세요."
                           Foreground="Gray"
                           FontSize="18"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                <ContentControl x:Name="EditorHost"/>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
